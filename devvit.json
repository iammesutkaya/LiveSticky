{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "live-sticky",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "scheduler": {
    "tasks": {
      "check-twitch-status": {
        "endpoint": "/internal/scheduler/check-status",
        "cron": "*/2 * * * *"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "menu": {
    "items": [
      {
        "label": "Create LiveSticky Dashboard",
        "description": "Creates a persistent custom post dashboard that auto-updates with live stream stats and platform links.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-dashboard"
      },
      {
        "label": "Restart LiveSticky",
        "description": "Clears cached stream status and runs an immediate status check.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/restart"
      },
      {
        "label": "Refresh Profile Images",
        "description": "Clears the cached avatar and banner URLs and re-fetches them from the platform API immediately.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/refresh-images"
      },
      {
        "label": "Get Default LiveSticky Templates",
        "description": "Opens the GitHub page with copy-pasteable templates for your settings.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/get-templates"
      }
    ]
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "permissions": {
    "reddit": {
      "scope": "moderator"
    },
    "redis": true,
    "http": {
      "enable": true,
      "domains": [
        "id.twitch.tv",
        "api.twitch.tv",
        "youtube.googleapis.com",
        "id.kick.com",
        "api.kick.com",
        "static-cdn.jtvnw.net",
        "yt3.googleusercontent.com",
        "i.ytimg.com",
        "files.kick.com",
        "i.redd.it"
      ]
    }
  },
  "dev": {
    "subreddit": "live_sticky_dev"
  }
}