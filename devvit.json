{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "live-sticky",
  "blocks": {
    "entry": "src/main.ts"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "regular",
        "inline": true
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "permissions": {
    "reddit": {
      "scope": "moderator"
    },
    "redis": true,
    "http": {
      "enable": true,
      "domains": [
        "id.twitch.tv",
        "api.twitch.tv",
        "youtube.googleapis.com",
        "id.kick.com",
        "api.kick.com"
      ]
    }
  },
  "dev": {
    "subreddit": "live_sticky_dev"
  }
}